# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional health-check port. Leave unset to open no port; hosts like Render/Railway set PORT themselves.
# PORT=8080

# Avortyx Stats API
# There is no default API key: each chat must set its own with /setapikey KEY.
AVORTYX_BASE_URL=https://avortyx.io/api/stats
# Timezone "today" is cut in for every stats request
TIMEZONE=America/New_York
# HTTP timeout for API calls (ms)
API_TIMEOUT_MS=30000

# Named workspaces a group can switch to with /setworkspace <name> to use a different API address.
# Add as many as needed: WORKSPACE_1_..., WORKSPACE_2_..., etc.
# BASE_URL is optional and falls back to AVORTYX_BASE_URL.
WORKSPACE_1_NAME=Main
WORKSPACE_1_BASE_URL=

# Access control
# Telegram user IDs allowed to run the /set... commands (comma-separated).
# Leave empty to allow any admin of the group.
BOT_ADMIN_USER_IDS=
# Chats allowed to use platform-wide commands (/viewbuyers, /viewcampaigns,
# /viewmissed, /getccupdate) when no buyer is set for the chat. Leave empty to allow all.
ADMIN_CHAT_IDS=

# Where per-group settings (/set... commands) are saved
DATA_FILE=./data/groups.json
